# Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model ID: latest stable Flash-class multimodal model (verified in Gemini docs)
GEMINI_MODEL=gemini-3.8-flash

# Pricing per million tokens in USD - Standard Tier (https://ai.google.dev/pricing)
PRICE_INPUT_PER_M_USD=0.75
PRICE_OUTPUT_PER_M_USD=3.75
